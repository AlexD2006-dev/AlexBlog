<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Alex' Blog - <%= post.title %></title>
        <link rel="stylesheet" href="/blog/css/style.css" />
    </head>
    <body>
        <header>
            <h1>Alex' Blog</h1>
            <% if(isAdmin) { %>
                <a href="/admin/logout">Logout</a>
            <% } else { %>
                <a href="/admin/login">Admin Login</a>
            <% } %>
            <nav>
                <a href="/blog/landing.html">Home</a>
                <a href="/about">About</a>
                <a href="/posts">Posts</a>
                <a href="/contact">Contact</a>
            </nav>
        </header>

        <main>
            <h2><%= post.title %></h2>
            <p><%= post.description %></p>
            <hr>
            <div class="post-content">
                <p><%= post.content %></p>
            </div>
            <% if(isAdmin) { %>
                <div class="actions">
                    <a href="/posts/<%= post.slug %>/edit">Edit</a>
                    <a href="/posts/<%= post.slug %>/delete">Delete</a>
                </div>
            <% } %>
            <a href="/posts">← Back to posts</a>
        </main>

        <footer>
            <p>&copy; 2026 Alex' Blog. All rights reserved.</p>
        </footer>
    </body>
</html>
